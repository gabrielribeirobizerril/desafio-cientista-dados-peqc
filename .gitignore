# Ambiente e artefatos do dbt
.venv
target/
dbt_packages/
dbt_internal_packages/
logs/

# Segredos. *.json é amplo de propósito: impede que uma chave de service
# account entre no repositório por engano. Para versionar um JSON legítimo,
# adicionar uma exceção explícita (ex.: !caminho/arquivo.json).
.env
*.json

# Notebooks de trabalho (o EDA é a exceção explícita abaixo)
*.ipynb

# Editor
.vscode/


# Notebook de análise exploratória (versionado)
!notebooks/i_eda.ipynb
# Notebook de análise dos achados
!notebooks/ii_analytics.ipynb
# Cache local das tabelas brutas lidas pelo notebook
notebooks/dados_raw/

# Dados exportados para gerar o relatório
scripts/relatorio/dados/

